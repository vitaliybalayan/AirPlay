<resources>
    <!-- Android 12+ always shows a system splash; match it to the app so the intro starts seamlessly. -->
    <style name="Theme.AirPlay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/startup_background</item>
        <item name="android:colorBackground">@color/startup_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/startup_background</item>
    </style>
</resources>
